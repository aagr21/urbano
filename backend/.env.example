# Servidor
NODE_ENV=development
PORT=3000

# Datos GTFS (zip)
GTFS_FILE=./gtfs.zip

# Base de datos (PostGIS en Docker, ver docker-compose.yml)
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=urbano
DB_PASSWORD=urbano
DB_DATABASE=urbano
DB_POOL_MAX=5
# En desarrollo TypeORM sincroniza el esquema automáticamente
DB_SYNCHRONIZE=true

# Motor de ruteo externo (OpenTripPlanner 2, GTFS + OSM).
# Vacío = planner interno sobre PostGIS. Con valor se consultan itinerarios
# puerta a puerta (caminatas por la red viaria) y el planner interno queda
# como fallback.
OTP_URL=http://localhost:8081/otp/routers/default
OTP_TIMEOUT_MS=8000

# Ruteador peatonal de respaldo (gratis, sin servidor propio). Cuando OTP no
# trazó la caminata (p. ej. producción Vercel, sin OTP), el backend pide la
# geometría por calles a una instancia de Valhalla; el mapa deja de cortar en
# recta por encima de las casas. Vacío = línea recta (comportamiento antiguo).
# La URL de demo es de cortesía (límites bajos): para tráfico real autoaloja
# Valhalla o usa una clave gratuita de OpenRouteService.
WALK_ROUTER_URL=https://valhalla1.openstreetmap.de/route
WALK_ROUTER_TIMEOUT_MS=5000

# CORS (separados por coma). Usa * para permitir todos
CORS_ORIGINS=*
BLOB_READ_WRITE_TOKEN=
