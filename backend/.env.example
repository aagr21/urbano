# Servidor
NODE_ENV=development
PORT=3000

# Datos GTFS (zip)
GTFS_FILE=./gtfs.zip

# Base de datos (PostGIS en Docker, ver docker-compose.yml)
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=urbano
DB_PASSWORD=urbano
DB_DATABASE=urbano
# En desarrollo TypeORM sincroniza el esquema automáticamente
DB_SYNCHRONIZE=true

# Motor de ruteo externo (OpenTripPlanner 2, GTFS + OSM).
# Vacío = planner interno sobre PostGIS. Con valor se consultan itinerarios
# puerta a puerta (caminatas por la red viaria) y el planner interno queda
# como fallback.
OTP_URL=http://localhost:8081/otp/routers/default
OTP_TIMEOUT_MS=8000

# CORS (separados por coma). Usa * para permitir todos
CORS_ORIGINS=*
