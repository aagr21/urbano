{
    "name": "urbano-backend",
    "version": "1.0.0",
    "description": "Backend de la app de transporte público (micros urbanos) de Santa Cruz de la Sierra",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "import:gtfs": "ts-node -P tsconfig.json -r tsconfig-paths/register src/modules/gtfs-import/import.cli.ts",
        "import:micros-images": "ts-node -P tsconfig.json -r tsconfig-paths/register src/modules/gtfs-import/micros-images.cli.ts",
        "fix:gtfs-directions": "ts-node -P tsconfig.json -r tsconfig-paths/register src/modules/gtfs-import/fix-directions.cli.ts",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
        "test:all": "npm run test && npm run test:e2e"
    },
    "dependencies": {
        "@nestjs/cache-manager": "^3.0.1",
        "@nestjs/common": "^11.1.6",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.6",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.0",
        "cache-manager": "^6.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "csv-parse": "^5.6.0",
        "helmet": "^8.1.0",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.27",
        "unzipper": "^0.12.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.5",
        "@nestjs/testing": "^11.1.6",
        "@types/express": "^5.0.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.0.14",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^6.0.3",
        "@types/unzipper": "^0.10.11",
        "jest": "^29.7.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1"
        }
    }
}
