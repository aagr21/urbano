                        <constraints>
                            <constraint firstItem="L0t-00-fr0" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="L0t-00-cx1"/>
                            <constraint firstItem="L0t-00-fr0" firstAttribute="width" secondItem="Ze5-6b-2t3" secondAttribute="width" multiplier="0.82" id="L0t-00-wd1"/>
