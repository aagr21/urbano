<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens de marca en nativo: son los mismos colores de AppColors (Dart).
     Se duplican aquí porque un recurso XML no puede leer Dart. -->
<resources>
    <!-- Verde luminoso: arranque del degradado de marca. -->
    <color name="urbano_aqua">#FF35F04F</color>
    <!-- Verde principal de la paleta: fondo de la portada nativa de 12+
         (el campo que se ve antes de SplashCanvasView; es el tono central
         del degradado, así el relevo no se lee como otra pantalla). -->
    <color name="urbano_primary">#FF06BD4A</color>
    <!-- Verde oscuro de la paleta: final del degradado. -->
    <color name="urbano_primary_dark">#FF029E46</color>
    <!-- Canvas del tema (claro): el MISMO `AppColors.canvasLight`, fondo de la
         ventana de `NormalTheme`, para que el handoff splash-app nunca asome en
         blanco puro de la plataforma. `values-night/` redefine este nombre a
         canvasDark, así que un solo `@color/urbano_canvas` sigue al modo del
         sistema sin duplicar el style. -->
    <color name="urbano_canvas">#FFFEFEFE</color>
</resources>
