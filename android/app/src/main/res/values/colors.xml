<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens de marca en nativo: son los mismos colores de AppColors (Dart).
     Se duplican aquí porque un recurso XML no puede leer Dart. -->
<resources>
    <!-- «La orilla»: arranque del degradado de marca. -->
    <color name="urbano_aqua">#FF2AD8C3</color>
    <!-- Primario, laguna: promedio del degradado y fondo de la portada de 12+. -->
    <color name="urbano_primary">#FF008C7B</color>
    <!-- Laguna profunda: final del degradado. -->
    <color name="urbano_primary_dark">#FF00584F</color>
    <!-- Canvas del tema (claro): el MISMO `AppColors.canvasLight`, fondo de la
         ventana de `NormalTheme`, para que el handoff splash-app nunca asome en
         blanco puro de la plataforma. `values-night/` redefine este nombre a
         canvasDark, así que un solo `@color/urbano_canvas` sigue al modo del
         sistema sin duplicar el style. -->
    <color name="urbano_canvas">#FFF2F2F7</color>
</resources>
